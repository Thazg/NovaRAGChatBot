# ─── Backend ──────────────────────────────────────────

# Provider: "groq" (cloud-free, no GPU) or "ollama" (local)
LLM_PROVIDER=groq
ENVIRONMENT=development
APP_VERSION=2.1.0

# Groq (default — get free API key at https://console.groq.com)
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Ollama (local fallback, requires GPU/CPU)
# OLLAMA_URL=http://localhost:11434
# MODEL_NAME=qwen3:4b-instruct

LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
READINESS_CACHE_SECONDS=10
LLM_SEED=42
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_REQUESTS=10
JWT_SECRET=replace_with_a_long_random_secret
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_SECONDS=2592000
# Production uses a host-only __Host-nova_refresh cookie automatically when
# COOKIE_SECURE=true. Keep false only for direct local HTTP development.
COOKIE_SECURE=false
# REFRESH_COOKIE_NAME=__Host-nova_refresh
# REFRESH_COOKIE_SAMESITE=strict
# Production persistence and shared infrastructure:
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/nova
# REDIS_URL=redis://default:password@host:6379/0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
# Production example:
# CORS_ORIGINS=https://novachatbot.vercel.app
# CORS_ORIGIN_REGEX=^https://nova-ai-agent(?:-[a-z0-9-]+)?-thazg-s-projects\.vercel\.app$
MAX_UPLOAD_BYTES=26214400
MAX_PDF_PAGES=500
MAX_PDF_OBJECTS=100000
MAX_PDF_DECOMPRESSED_STREAM_BYTES=10485760
MAX_PDF_EXTRACTED_CHARS=5000000
MAX_ARCHIVE_ENTRIES=2000
MAX_ARCHIVE_UNCOMPRESSED_BYTES=104857600
MAX_ARCHIVE_COMPRESSION_RATIO=100
MAX_NOTEBOOK_CELLS=2000
# Configure ClamAV and set required=true before opening uploads publicly.
# CLAMAV_HOST=clamav.internal
# CLAMAV_PORT=3310
MALWARE_SCAN_REQUIRED=false

# Optional OpenAI-compatible embeddings API. Leave empty for BM25-only retrieval.
# EMBEDDING_BASE_URL=https://your-embedding-provider.example/v1
# EMBEDDING_API_KEY=your_embedding_key
# EMBEDDING_MODEL=nomic-embed-text-v1.5

# Backblaze B2 (persistent storage for production)
# B2_KEY_ID=00485d7e4156fd00000000001
# B2_APP_KEY=K004...
# B2_BUCKET=nova-ai-storage
# B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com

# ─── Frontend ──────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
