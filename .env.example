# ─── Backend ──────────────────────────────────────────

# Provider: "groq" (cloud-free, no GPU) or "ollama" (local)
LLM_PROVIDER=groq
ENVIRONMENT=development
APP_VERSION=2.1.0

# Groq (default — get free API key at https://console.groq.com)
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Ollama (local fallback, requires GPU/CPU)
# OLLAMA_URL=http://localhost:11434
# MODEL_NAME=qwen3:4b-instruct

LOG_LEVEL=INFO
READINESS_CACHE_SECONDS=10
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_REQUESTS=10
JWT_SECRET=replace_with_a_long_random_secret
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
MAX_UPLOAD_BYTES=26214400

# Optional OpenAI-compatible embeddings API. Leave empty for BM25-only retrieval.
# EMBEDDING_BASE_URL=https://your-embedding-provider.example/v1
# EMBEDDING_API_KEY=your_embedding_key
# EMBEDDING_MODEL=nomic-embed-text-v1.5

# Backblaze B2 (persistent storage for production)
# B2_KEY_ID=00485d7e4156fd00000000001
# B2_APP_KEY=K004...
# B2_BUCKET=nova-ai-storage
# B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com

# ─── Frontend ──────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
