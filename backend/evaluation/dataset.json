{
  "name": "Nova arXiv PDF retrieval benchmark",
  "version": "1.0.0",
  "dataset_type": "reproducible_arxiv_pdf_benchmark",
  "paper_count": 10,
  "question_count": 100,
  "answerable_count": 90,
  "unanswerable_count": 10,
  "manifest": "arxiv_corpus/manifest.json",
  "checksum_lock": "arxiv_corpus/checksums.json",
  "annotations": "arxiv_corpus/annotation_specs.json",
  "generated_dataset": "arxiv_corpus/generated_dataset.json",
  "build_commands": [
    "python evaluation/arxiv_corpus/download_papers.py",
    "python evaluation/arxiv_corpus/extract_corpus.py",
    "python evaluation/arxiv_corpus/build_dataset.py"
  ],
  "note": "PDF binaries and extracted full text are generated artifacts. They are not committed; version pins, SHA-256 checksums, questions, reference answers, evidence spans, and review state are committed."
}
